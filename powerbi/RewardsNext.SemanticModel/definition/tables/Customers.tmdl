table Customers

	column customer_id
		dataType: string
		summarizeBy: none
		sourceColumn: customer_id

	column became_member_on
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: became_member_on

	column membership_year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: membership_year

	column tenure_band
		dataType: string
		summarizeBy: none
		sourceColumn: tenure_band

	column gender_clean
		dataType: string
		summarizeBy: none
		sourceColumn: gender_clean

	column age
		dataType: double
		summarizeBy: average
		sourceColumn: age

	column age_group
		dataType: string
		summarizeBy: none
		sourceColumn: age_group

	column income
		dataType: double
		formatString: #,0
		summarizeBy: average
		sourceColumn: income

	column income_band
		dataType: string
		summarizeBy: none
		sourceColumn: income_band

	column profile_complete
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		summarizeBy: none
		sourceColumn: profile_complete

	column offers_received
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: offers_received

	column offers_viewed
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: offers_viewed

	column offers_completed
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: offers_completed

	column completion_rate
		dataType: double
		formatString: 0.0%
		summarizeBy: average
		sourceColumn: completion_rate

	column txn_count
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: txn_count

	column total_spend
		dataType: double
		formatString: \$#,0.00
		summarizeBy: sum
		sourceColumn: total_spend

	column engagement_segment
		dataType: string
		summarizeBy: none
		sourceColumn: engagement_segment

	partition Customers = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("D:\Users\Ravindra\Desktop\RewardsNext_Capstone\model\dim_customer.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {
				        {"customer_id", type text},
				        {"became_member_on", type date},
				        {"membership_year", Int64.Type},
				        {"tenure_days_at_snapshot", Int64.Type},
				        {"tenure_band", type text},
				        {"gender", type text},
				        {"gender_clean", type text},
				        {"age", type number},
				        {"age_group", type text},
				        {"age_is_missing", type logical},
				        {"income", type number},
				        {"income_band", type text},
				        {"profile_complete", type logical},
				        {"offers_received", Int64.Type},
				        {"offers_viewed", Int64.Type},
				        {"offers_completed", Int64.Type},
				        {"view_rate", type number},
				        {"completion_rate", type number},
				        {"txn_count", Int64.Type},
				        {"total_spend", type number},
				        {"avg_txn", type number},
				        {"engagement_segment", type text}
				    }),
				    Removed = Table.RemoveColumns(Typed, {"tenure_days_at_snapshot", "gender", "age_is_missing", "view_rate", "avg_txn"})
				in
				    Removed

	annotation PBI_ResultType = Table
