table Offers

	column offer_id
		dataType: string
		summarizeBy: none
		sourceColumn: offer_id

	column offer_label
		dataType: string
		summarizeBy: none
		sourceColumn: offer_label

	column offer_type
		dataType: string
		summarizeBy: none
		sourceColumn: offer_type

	column difficulty
		dataType: int64
		formatString: \$#,0
		summarizeBy: none
		sourceColumn: difficulty

	column reward
		dataType: int64
		formatString: \$#,0
		summarizeBy: none
		sourceColumn: reward

	column duration
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: duration

	column duration_hours
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: duration_hours

	column channels_text
		dataType: string
		summarizeBy: none
		sourceColumn: channels_text

	column channel_count
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: channel_count

	column reward_per_dollar
		dataType: double
		formatString: 0.00
		summarizeBy: none
		sourceColumn: reward_per_dollar

	column is_informational
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		summarizeBy: none
		sourceColumn: is_informational

	partition Offers = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("D:\Users\Ravindra\Desktop\RewardsNext_Capstone\model\dim_offer.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {
				        {"offer_id", type text},
				        {"offer_label", type text},
				        {"offer_type", type text},
				        {"difficulty", Int64.Type},
				        {"reward", Int64.Type},
				        {"duration", Int64.Type},
				        {"duration_hours", Int64.Type},
				        {"channels_text", type text},
				        {"channel_count", Int64.Type},
				        {"reward_per_dollar", type number},
				        {"is_informational", type logical}
				    })
				in
				    Typed

	annotation PBI_ResultType = Table
